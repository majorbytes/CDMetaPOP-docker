# Copy to `.env` and edit. docker compose reads these automatically.

# Host directory that becomes /data inside the container.
# This is the persistent location for your input files AND all run output.
# Use an absolute path to place it on your server's storage, e.g.:
#   DATA_DIR=/srv/cdmetapop/data
# or keep the default local ./data folder next to this compose file:
DATA_DIR=./data

# Which run-parameter file to execute (path relative to DATA_DIR).
RUNVARS=RunVars_demo.csv

# Output folder prefix (CDMetaPOP appends a timestamp).
OUTPUT_NAME=demo

# Seed an empty DATA_DIR with the bundled example inputs (1=yes, 0=no).
SEED_EXAMPLES=1
